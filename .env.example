# --- Required ---------------------------------------------------------------
# Notion internal integration token (starts with "ntn_" or "secret_")
# Create one at https://www.notion.so/my-integrations, then share your database with it.
NOTION_TOKEN=

# The database ID — the 32-char hex segment from the database URL:
# https://www.notion.so/workspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=

# BulkPublish API key (starts with "bp_") — https://app.bulkpublish.com/developer
BULKPUBLISH_API_KEY=

# --- Optional ----------------------------------------------------------------
# Poll interval in seconds for `npm start` (default 60)
POLL_INTERVAL=60

# IANA timezone used for scheduled posts (default: system timezone)
# TIMEZONE=Asia/Karachi

# Override Notion property names if your database uses different ones
# NOTION_PROP_CAPTION=Caption
# NOTION_PROP_CHANNELS=Channels
# NOTION_PROP_MEDIA=Media
# NOTION_PROP_SCHEDULE=Schedule
# NOTION_PROP_STATUS=Status
# NOTION_PROP_RESULT=Result

# Override the Status option names
# NOTION_STATUS_READY=Ready
# NOTION_STATUS_POSTING=Posting
# NOTION_STATUS_POSTED=Posted
# NOTION_STATUS_FAILED=Failed
